// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model PropertyCategory {
  id          String     @id @default(uuid())
  title       String     @unique // "House for rent", "House for sale", "Land for sale"...
  slug        String     @unique // "house-for-rent"
  description String?
  icon        String?
  properties  Property[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model HouseType {
  id         String     @id @default(uuid())
  name       String     @unique // Apartment, Condominium, Standalone, Duplex, Single Room
  properties Property[]
}

model LandType {
  id         String     @id @default(uuid())
  name       String     @unique // Residential, Commercial, Agricultural, Mixed Use
  properties Property[]
}

model PropertyType {
  id         String     @id @default(uuid())
  name       String     @unique // Office Building, Retail Shop, Petrol Station...
  group      String // "COMMERCIAL_BUILDING" | "COMMERCIAL_LAND"
  properties Property[]
}

model Feature {
  id         String            @id @default(uuid())
  name       String            @unique // Road Access, Electricity, Water Supply, Pool...
  properties PropertyFeature[]
}

// ===================== LOCATION =====================

model Region {
  id         String     @id @default(uuid())
  name       String     @unique
  districts  District[]
  properties Property[]
}

model District {
  id         String     @id @default(uuid())
  name       String
  region     Region     @relation(fields: [regionId], references: [id], onDelete: Cascade)
  regionId   String
  wards      Ward[]
  properties Property[]

  @@unique([name, regionId])
}

model Ward {
  id         String     @id @default(uuid())
  name       String
  district   District   @relation(fields: [districtId], references: [id], onDelete: Cascade)
  districtId String
  properties Property[]

  @@unique([name, districtId])
}

// ===================== PEOPLE =====================

model Broker {
  id          String       @id @default(uuid())
  name        String
  phone       String?
  email       String?
  properties  Property[]
  deals       Deal[]
  commissions Commission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Owner {
  id         String     @id @default(uuid())
  name       String
  phone      String?
  email      String?
  properties Property[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

// ===================== PROPERTY =====================

model Property {
  id    String @id @default(uuid())
  title String

  category   PropertyCategory @relation(fields: [categoryId], references: [id])
  categoryId String

  houseType   HouseType? @relation(fields: [houseTypeId], references: [id])
  houseTypeId String?

  landType   LandType? @relation(fields: [landTypeId], references: [id])
  landTypeId String?

  propertyType   PropertyType? @relation(fields: [propertyTypeId], references: [id])
  propertyTypeId String?

  // Pricing
  monthlyRent Decimal? @db.Decimal(14, 2)
  salePrice   Decimal? @db.Decimal(14, 2)
  rentalTerm  String? // MONTHLY, 3_MONTHS, 4_MONTHS, 6_MONTHS, YEARLY

  // Size
  size     Decimal? @db.Decimal(12, 2)
  sizeUnit String? // sqm, acre, plot, metre, feet

  // House specific
  bedrooms  Int?
  bathrooms Int?

  status String @default("ACTIVE") // ACTIVE, PENDING, SOLD, RENTED, ARCHIVED

  // People
  broker   Broker? @relation(fields: [brokerId], references: [id])
  brokerId String?
  owner    Owner?  @relation(fields: [ownerId], references: [id])
  ownerId  String?

  // Location
  region        Region?   @relation(fields: [regionId], references: [id])
  regionId      String?
  district      District? @relation(fields: [districtId], references: [id])
  districtId    String?
  ward          Ward?     @relation(fields: [wardId], references: [id])
  wardId        String?
  exactLocation String?
  latitude      Float?
  longitude     Float?

  // Description
  description String? @db.Text
  language    String  @default("ENGLISH") // ENGLISH, KISWAHILI

  // Relations
  features  PropertyFeature[]
  images    PropertyImage[]
  documents PropertyDocument[]
  deals     Deal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, status])
}

model PropertyFeature {
  id         String   @id @default(uuid())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  feature    Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)
  featureId  String

  @@unique([propertyId, featureId])
}

model PropertyImage {
  id         String   @id @default(uuid())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  url        String
  isCover    Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model PropertyDocument {
  id         String   @id @default(uuid())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  name       String // Title Deed, Survey Plan, Sale Agreement...
  url        String
  fileType   String?
  sizeBytes  Int?
  createdAt  DateTime @default(now())
}

// ===================== DEALS & COMMISSIONS =====================

model Deal {
  id          String       @id @default(uuid())
  property    Property     @relation(fields: [propertyId], references: [id])
  propertyId  String
  broker      Broker?      @relation(fields: [brokerId], references: [id])
  brokerId    String?
  clientName  String
  clientPhone String?
  clientEmail String?
  status      String       @default("OPEN") // OPEN, NEGOTIATING, CLOSED_WON, CLOSED_LOST
  agreedPrice Decimal?     @db.Decimal(14, 2)
  commissions Commission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Commission {
  id         String    @id @default(uuid())
  deal       Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId     String
  broker     Broker    @relation(fields: [brokerId], references: [id])
  brokerId   String
  amount     Decimal   @db.Decimal(14, 2)
  percentage Decimal?  @db.Decimal(5, 2)
  paid       Boolean   @default(false)
  paidAt     DateTime?
  createdAt  DateTime  @default(now())
}
