// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}


model PropertyCategory {
  id          String     @id @default(uuid())
  title       String     @unique   // "House for rent", "House for sale", "Land for sale"...
  slug        String     @unique   // "house-for-rent"
  description String?
  icon        String?
  properties  Property[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model HouseType {
  id         String     @id @default(uuid())
  name       String     @unique   // Apartment, Condominium, Standalone, Duplex, Single Room
  properties Property[]
}

model LandType {
  id         String     @id @default(uuid())
  name       String     @unique   // Residential, Commercial, Agricultural, Mixed Use
  properties Property[]
}

model PropertyType {
  id         String     @id @default(uuid())
  name       String     @unique   // Office Building, Retail Shop, Petrol Station...
  group      String     // "COMMERCIAL_BUILDING" | "COMMERCIAL_LAND"
  properties Property[]
}

model Feature {
  id         String            @id @default(uuid())
  name       String            @unique // Road Access, Electricity, Water Supply, Pool...
  properties PropertyFeature[]
}

// ===================== LOCATION =====================

model Region {
  id         String     @id @default(uuid())
  name       String     @unique
  districts  District[]
  properties Property[]
}

model District {
  id         String     @id @default(uuid())
  name       String
  region     Region     @relation(fields: [regionId], references: [id], onDelete: Cascade)
  regionId   String
  wards      Ward[]
  properties Property[]

  @@unique([name, regionId])
}

model Ward {
  id         String     @id @default(uuid())
  name       String
  district   District   @relation(fields: [districtId], references: [id], onDelete: Cascade)
  districtId String
  properties Property[]

  @@unique([name, districtId])
}

// ===================== PEOPLE =====================

model Broker {
  id          String       @id @default(uuid())
  name        String
  phone       String?
  email       String?
  properties  Property[]
  deals       Deal[]
  commissions Commission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Owner {
  id         String     @id @default(uuid())
  name       String
  phone      String?
  email      String?
  properties Property[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

// ===================== PROPERTY =====================

model Property {
  id          String   @id @default(uuid())
  title       String

  category    PropertyCategory @relation(fields: [categoryId], references: [id])
  categoryId  String

  houseType   HouseType?       @relation(fields: [houseTypeId], references: [id])
  houseTypeId String?

  landType    LandType?        @relation(fields: [landTypeId], references: [id])
  landTypeId  String?

  propertyType   PropertyType? @relation(fields: [propertyTypeId], references: [id])
  propertyTypeId String?

  // Pricing
  monthlyRent Decimal? @db.Decimal(14, 2)
  salePrice   Decimal? @db.Decimal(14, 2)
  rentalTerm  String?  // MONTHLY, 3_MONTHS, 4_MONTHS, 6_MONTHS, YEARLY

  // Size
  size        Decimal? @db.Decimal(12, 2)
  sizeUnit    String?  // sqm, acre, plot, metre, feet

  // House specific
  bedrooms    Int?
  bathrooms   Int?

  status      String   @default("ACTIVE") // ACTIVE, PENDING, SOLD, RENTED, ARCHIVED

  // People
  broker      Broker?  @relation(fields: [brokerId], references: [id])
  brokerId    String?
  owner       Owner?   @relation(fields: [ownerId], references: [id])
  ownerId     String?

  // Location
  region      Region?   @relation(fields: [regionId], references: [id])
  regionId    String?
  district    District? @relation(fields: [districtId], references: [id])
  districtId  String?
  ward        Ward?     @relation(fields: [wardId], references: [id])
  wardId      String?
  exactLocation String?
  latitude    Float?
  longitude   Float?

  // Description
  description String?  @db.Text
  language    String   @default("ENGLISH") // ENGLISH, KISWAHILI

  // Relations
  features    PropertyFeature[]
  images      PropertyImage[]
  documents   PropertyDocument[]
  deals       Deal[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId, status])
}

model PropertyFeature {
  id         String   @id @default(uuid())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  feature    Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)
  featureId  String

  @@unique([propertyId, featureId])
}

model PropertyImage {
  id         String   @id @default(uuid())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  url        String
  isCover    Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model PropertyDocument {
  id         String   @id @default(uuid())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  name       String   // Title Deed, Survey Plan, Sale Agreement...
  url        String
  fileType   String?
  sizeBytes  Int?
  createdAt  DateTime @default(now())
}

// ===================== DEALS & COMMISSIONS =====================

model Deal {
  id          String       @id @default(uuid())
  property    Property     @relation(fields: [propertyId], references: [id])
  propertyId  String
  broker      Broker?      @relation(fields: [brokerId], references: [id])
  brokerId    String?
  clientName  String
  clientPhone String?
  clientEmail String?
  status      String       @default("OPEN") // OPEN, NEGOTIATING, CLOSED_WON, CLOSED_LOST
  agreedPrice Decimal?     @db.Decimal(14, 2)
  commissions Commission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Commission {
  id         String    @id @default(uuid())
  deal       Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId     String
  broker     Broker    @relation(fields: [brokerId], references: [id])
  brokerId   String
  amount     Decimal   @db.Decimal(14, 2)
  percentage Decimal?  @db.Decimal(5, 2)
  paid       Boolean   @default(false)
  paidAt     DateTime?
  createdAt  DateTime  @default(now())
}




///////////////////////////////////

// ===================== HOUSE FOR SALE =====================

model HouseForSale {
  id            String     @id @default(uuid())
  title         String     // e.g. "4 Bedroom House for Sale in Masaki"

  salePrice     Decimal    @db.Decimal(14, 2)
  sizeUnit      String?    // sqm, acre, plot, metre, feet
  size          Decimal?   @db.Decimal(12, 2)

  houseType     HouseType? @relation(fields: [houseTypeId], references: [id])
  houseTypeId   String?

  bedrooms      Int?
  bathrooms     Int?

  status        String     @default("ACTIVE") // ACTIVE, PENDING, SOLD, ARCHIVED

  broker        Broker?    @relation(fields: [brokerId], references: [id])
  brokerId      String?
  owner         Owner?     @relation(fields: [ownerId], references: [id])
  ownerId       String?

  region        Region?    @relation(fields: [regionId], references: [id])
  regionId      String?
  district      District?  @relation(fields: [districtId], references: [id])
  districtId    String?
  ward          Ward?      @relation(fields: [wardId], references: [id])
  wardId        String?
  exactLocation String?
  latitude      Float?
  longitude     Float?

  description   String?    @db.Text
  language      String     @default("ENGLISH")

  features      HouseForSaleFeature[]
  images        HouseForSaleImage[]
  documents     HouseForSaleDocument[]

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status])
}

model HouseForSaleFeature {
  id             String       @id @default(uuid())
  house          HouseForSale @relation(fields: [houseId], references: [id], onDelete: Cascade)
  houseId        String
  feature        Feature      @relation(fields: [featureId], references: [id], onDelete: Cascade)
  featureId      String

  @@unique([houseId, featureId])
}

model HouseForSaleImage {
  id         String       @id @default(uuid())
  house      HouseForSale @relation(fields: [houseId], references: [id], onDelete: Cascade)
  houseId    String
  url        String
  isCover    Boolean      @default(false)
  createdAt  DateTime     @default(now())
}

model HouseForSaleDocument {
  id         String       @id @default(uuid())
  house      HouseForSale @relation(fields: [houseId], references: [id], onDelete: Cascade)
  houseId    String
  name       String       // Title Deed, Survey Plan, Sale Agreement
  url        String
  fileType   String?
  sizeBytes  Int?
  createdAt  DateTime     @default(now())
}

// ===================== LAND FOR SALE =====================

model LandForSale {
  id            String     @id @default(uuid())
  title         String     // e.g. "2-Acre Plot for Sale in Bagamoyo"

  salePrice     Decimal    @db.Decimal(14, 2)
  sizeUnit      String?    // sqm, acre, plot, metre, feet
  size          Decimal?   @db.Decimal(12, 2)

  landType      LandType?  @relation(fields: [landTypeId], references: [id])
  landTypeId    String?

  status        String     @default("ACTIVE") // ACTIVE, PENDING, SOLD, ARCHIVED

  broker        Broker?    @relation(fields: [brokerId], references: [id])
  brokerId      String?
  owner         Owner?     @relation(fields: [ownerId], references: [id])
  ownerId       String?

  region        Region?    @relation(fields: [regionId], references: [id])
  regionId      String?
  district      District?  @relation(fields: [districtId], references: [id])
  districtId    String?
  ward          Ward?      @relation(fields: [wardId], references: [id])
  wardId        String?
  exactLocation String?
  latitude      Float?
  longitude     Float?

  description   String?    @db.Text
  language      String     @default("ENGLISH")

  features      LandForSaleFeature[]
  images        LandForSaleImage[]
  documents     LandForSaleDocument[]

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status])
}

model LandForSaleFeature {
  id         String      @id @default(uuid())
  land       LandForSale @relation(fields: [landId], references: [id], onDelete: Cascade)
  landId     String
  feature    Feature     @relation(fields: [featureId], references: [id], onDelete: Cascade)
  featureId  String

  @@unique([landId, featureId])
}

model LandForSaleImage {
  id         String      @id @default(uuid())
  land       LandForSale @relation(fields: [landId], references: [id], onDelete: Cascade)
  landId     String
  url        String
  isCover    Boolean     @default(false)
  createdAt  DateTime    @default(now())
}

model LandForSaleDocument {
  id         String      @id @default(uuid())
  land       LandForSale @relation(fields: [landId], references: [id], onDelete: Cascade)
  landId     String
  name       String
  url        String
  fileType   String?
  sizeBytes  Int?
  createdAt  DateTime    @default(now())
}

// ===================== COMMERCIAL AREA =====================
// Covers both "Commercial area for sale" and "Commercial area for rent"

model CommercialArea {
  id             String        @id @default(uuid())
  title          String        // e.g. "Office space for rent in CBD"

  listingType    String        // SALE | RENT
  salePrice      Decimal?      @db.Decimal(14, 2)
  monthlyRent    Decimal?      @db.Decimal(14, 2)
  rentalTerm     String?       // MONTHLY, 3_MONTHS, 4_MONTHS, 6_MONTHS, YEARLY

  sizeUnit       String?       // sqm, acre, plot, metre, feet
  size           Decimal?      @db.Decimal(12, 2)

  propertyType   PropertyType? @relation(fields: [propertyTypeId], references: [id])
  propertyTypeId String?       // Office Building, Warehouse, Petrol Station...

  status         String        @default("ACTIVE") // ACTIVE, PENDING, SOLD, RENTED, ARCHIVED

  broker         Broker?       @relation(fields: [brokerId], references: [id])
  brokerId       String?
  owner          Owner?        @relation(fields: [ownerId], references: [id])
  ownerId        String?

  region         Region?       @relation(fields: [regionId], references: [id])
  regionId       String?
  district       District?     @relation(fields: [districtId], references: [id])
  districtId     String?
  ward           Ward?         @relation(fields: [wardId], references: [id])
  wardId         String?
  exactLocation  String?
  latitude       Float?
  longitude      Float?

  description    String?       @db.Text
  language       String        @default("ENGLISH")

  images         CommercialAreaImage[]
  documents      CommercialAreaDocument[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, listingType])
}

model CommercialAreaImage {
  id           String          @id @default(uuid())
  commercial   CommercialArea  @relation(fields: [commercialId], references: [id], onDelete: Cascade)
  commercialId String
  url          String
  isCover      Boolean         @default(false)
  createdAt    DateTime        @default(now())
}

model CommercialAreaDocument {
  id           String          @id @default(uuid())
  commercial   CommercialArea  @relation(fields: [commercialId], references: [id], onDelete: Cascade)
  commercialId String
  name         String
  url          String
  fileType     String?
  sizeBytes    Int?
  createdAt    DateTime        @default(now())
}