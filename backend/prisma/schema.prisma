// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  ADMIN
  MARKETER
  DIRECTOR
}

model User {
  id        String   @id @default(uuid())
  username  String   
  email     String   @unique
  password  String
  role      String   @default("DIRECTOR") // USER | ADMIN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



// ==========================================
// ENUMS FOR DATA VALIDATION (Based on Oweru Specs)


enum SizeUnit {
  sqm
  acre
  plot
  metre
  feet
}

enum ListingKind {
  single
  project
  unit
}

// ==========================================
// THE CORE PROPERTIES MODEL
// ==========================================
model Property {
  id               String           @id @default(uuid())
  externalId       String           @unique // Required: Permanent ID for syncing
  status           String           // Required: "verified", "withdrawn", "sold", "rented"
  verifiedAt       DateTime?        // Optional
  verifiedBy       String?          // Optional
  sourceUrl        String?          @db.Text // Optional
  
  // Property details
  title            String           @db.VarChar(255) // Required headline
  category         String           // Required: category slug, e.g. "house-for-sale"
  price            Decimal          @db.Decimal(14, 2) // Required: Monthly for rent, total for sale
  rentMonths       Int?             // Optional (Required for rent category)
  description      String?          @db.LongText // Optional long form data
  
  // Property Category Specifics
  houseType        String?          // Conditional: type slug/value, e.g. "apartment"
  commercialType   String?          // Conditional: Matches your custom commercial list
  landType         String?          // Conditional: type slug/value, e.g. "residential"
  bedrooms         Int?             // Conditional
  bathrooms        Int?             // Conditional
  ensuiteCount     Int?             // Optional
  
  // Nested Size Object Flattened
  sizeValue        Decimal?         @db.Decimal(12, 2)
  sizeUnit         SizeUnit?        
  sizeWidth        Decimal?         @db.Decimal(10, 2)
  sizeLength       Decimal?         @db.Decimal(10, 2)
  
  // Dynamic Features List / Free-text
  features         Json?            // Array array of strings, e.g. ["parking", "security"]
  featuresOther    String?          @db.Text // Optional free-text
  
  // Nested Location Object Flattened
  locationRegion   String           // Required
  locationDistrict String           // Required
  locationWard     String?          
  locationStreet   String?          
  locationGpsLat   Decimal?         @db.Decimal(9, 6)
  locationGpsLng   Decimal?         @db.Decimal(9, 6)
  
  // Nested People Data Flattened (Keeps one person tracking robust)
  ownerFullName    String?          
  ownerPhone       String?          @db.VarChar(30)
  ownerAltPhone    String?          @db.VarChar(30)
  ownerEmail       String?          @db.VarChar(255)
  ownerNationalId  String?          @db.VarChar(50) // NIDA number
  
  brokerFullName   String?          
  brokerPhone      String?          @db.VarChar(30)
  brokerAltPhone   String?          @db.VarChar(30)
  brokerEmail      String?          @db.VarChar(255)
  brokerNatReg     String?          // Broker operating region
  brokerNatDist    String?          // Broker operating district
  
  // Media Assets Arrays
  images           Json?            // Array of valid image URLs
  videos           Json?            // Array of valid video URLs
  
  // Scheme Relationships
  listingKind      ListingKind      @default(single)
  parentExternalId String?          // References another property's externalId if it's a unit
  unitLabel        String?          @db.VarChar(50)  // Unique code within that scheme
  
  // Timestamps for audit
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@map("Properties") // Forces SQL layer to use capital "Properties" name
}








model PropertyCategory {
  id                 String           @id @default(uuid())
  title              String           @unique // "House for rent", "House for sale", "Land for sale"...
  slug               String           @unique // "house-for-rent"
  description        String?
  icon               String?
  houseForSale       HouseForSale[]
  landForSale        LandForSale[]
  commercialProperty CommercialArea[]
  accent             String? @default("#3B6FE0")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model HouseType {
  id           String         @id @default(uuid())
  name         String         @unique // Apartment, Condominium, Standalone, Duplex, Single Room
  houseForSale HouseForSale[]
}

model LandType {
  id          String        @id @default(uuid())
  name        String        @unique // Residential, Commercial, Agricultural, Mixed Use
  landForSale LandForSale[]
}

model PropertyType {
  id             String           @id @default(uuid())
  name           String           @unique // Office Building, Retail Shop, Petrol Station...
  group          String // "COMMERCIAL_BUILDING" | "COMMERCIAL_LAND"
  commercialArea CommercialArea[]
}

// ===================== LOCATION =====================

model Region {
  id                 String           @id @default(uuid())
  name               String           @unique
  districts          District[]
  houseForSale       HouseForSale[]
  landForSale        LandForSale[]
  commercialProperty CommercialArea[]
}

model District {
  id                 String           @id @default(uuid())
  name               String
  region             Region           @relation(fields: [regionId], references: [id], onDelete: Cascade)
  regionId           String
  wards              Ward[]
  houseForSale       HouseForSale[]
  landForSale        LandForSale[]
  commercialProperty CommercialArea[]

  @@unique([name, regionId])
}

model Ward {
  id                 String           @id @default(uuid())
  name               String
  district           District         @relation(fields: [districtId], references: [id], onDelete: Cascade)
  districtId         String
  houseForSale       HouseForSale[]
  landForSale        LandForSale[]
  commercialProperty CommercialArea[]

  @@unique([name, districtId])
}

// ===================== PEOPLE =====================

model Broker {
  id                 String           @id @default(uuid())
  name               String
  phone              String
  nid                String?
  tin                String?
  email              String?
  houseForSale       HouseForSale[]
  landForSale        LandForSale[]
  commercialProperty CommercialArea[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model Owner {
  id                 String           @id @default(uuid())
  name               String
  phone              String
  nid                String?
  tin                String?
  email              String?
  houseForSale       HouseForSale[]
  landForSale        LandForSale[]
  commercialProperty CommercialArea[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

// ===================== PROPERTY =====================

// ===================== HOUSE FOR SALE =====================

model HouseForSale {
  id    String @id @default(uuid())
  title String // e.g. "4 Bedroom House for Sale in Masaki"

  salePrice Decimal  @db.Decimal(14, 2)
  sizeUnit  String? // sqm, acre, plot, metre, feet
  size      Decimal? @db.Decimal(12, 2)

  houseType   HouseType? @relation(fields: [houseTypeId], references: [id])
  houseTypeId String?

  bedrooms  Int?
  bathrooms Int?

  status String @default("PENDING") // ACTIVE, PENDING, SOLD, APPROVED

  propertyCategory   PropertyCategory? @relation(fields: [propertyCategoryId], references: [id])
  propertyCategoryId String?

  broker   Broker? @relation(fields: [brokerId], references: [id])
  brokerId String?
  owner    Owner?  @relation(fields: [ownerId], references: [id])
  ownerId  String?

  region        Region?   @relation(fields: [regionId], references: [id])
  regionId      String?
  district      District? @relation(fields: [districtId], references: [id])
  districtId    String?
  ward          Ward?     @relation(fields: [wardId], references: [id])
  wardId        String?
  exactLocation String?
  latitude      Float?
  longitude     Float?

  description String? @db.Text
  language    String  @default("ENGLISH")

  features  HouseForSaleFeature[]
  images    HouseForSaleImage[]
  documents HouseForSaleDocument[]
  videos    HouseForSaleVideo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model HouseForSaleFeature {
  id      String       @id @default(uuid())
  name    String
  house   HouseForSale @relation(fields: [houseId], references: [id], onDelete: Cascade)
  houseId String
}

model HouseForSaleImage {
  id        String       @id @default(uuid())
  house     HouseForSale @relation(fields: [houseId], references: [id], onDelete: Cascade)
  houseId   String
  url       String       @db.LongText
  isCover   Boolean      @default(false)
  createdAt DateTime     @default(now())
}

model HouseForSaleDocument {
  id        String       @id @default(uuid())
  house     HouseForSale @relation(fields: [houseId], references: [id], onDelete: Cascade)
  houseId   String
  name      String // Title Deed, Survey Plan, Sale Agreement
  url       String       @db.LongText
  fileType  String?
  sizeBytes Int?
  createdAt DateTime     @default(now())
}

model HouseForSaleVideo {
  id        String      @id @default(uuid())
  house     HouseForSale @relation(fields: [houseId], references: [id], onDelete: Cascade)
  houseId   String
  url       String      @db.LongText
  fileType  String?
  sizeBytes Int?
  createdAt DateTime    @default(now())
}

// ===================== LAND FOR SALE =====================

model LandForSale {
  id    String @id @default(uuid())
  title String // e.g. "2-Acre Plot for Sale in Bagamoyo"

  salePrice Decimal  @db.Decimal(14, 2)
  sizeUnit  String? // sqm, acre, plot, metre, feet
  size      Decimal? @db.Decimal(12, 2)

  landType   LandType? @relation(fields: [landTypeId], references: [id])
  landTypeId String?

  status String @default("PENDING") // ACTIVE, PENDING, SOLD, ARCHIVED

  propertyCategory   PropertyCategory? @relation(fields: [propertyCategoryId], references: [id])
  propertyCategoryId String?

  broker   Broker? @relation(fields: [brokerId], references: [id])
  brokerId String?
  owner    Owner?  @relation(fields: [ownerId], references: [id])
  ownerId  String?

  region        Region?   @relation(fields: [regionId], references: [id])
  regionId      String?
  district      District? @relation(fields: [districtId], references: [id])
  districtId    String?
  ward          Ward?     @relation(fields: [wardId], references: [id])
  wardId        String?
  exactLocation String?
  latitude      Float?
  longitude     Float?

  description String? @db.Text
  language    String  @default("ENGLISH")

  features  LandForSaleFeature[]
  images    LandForSaleImage[]
  documents LandForSaleDocument[]
  videos    LandForSaleVideo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model LandForSaleFeature {
  id     String      @id @default(uuid())
  name   String
  land   LandForSale @relation(fields: [landId], references: [id], onDelete: Cascade)
  landId String
}

model LandForSaleImage {
  id        String      @id @default(uuid())
  land      LandForSale @relation(fields: [landId], references: [id], onDelete: Cascade)
  landId    String
  url       String       @db.LongText
  isCover   Boolean     @default(false)
  createdAt DateTime    @default(now())
}

model LandForSaleDocument {
  id        String      @id @default(uuid())
  land      LandForSale @relation(fields: [landId], references: [id], onDelete: Cascade)
  landId    String
  name      String
  url       String       @db.LongText
  fileType  String?
  sizeBytes Int?
  createdAt DateTime    @default(now())
}

model LandForSaleVideo {
  id        String     @id @default(uuid())
  land      LandForSale @relation(fields: [landId], references: [id], onDelete: Cascade)
  landId    String
  url       String     @db.LongText
  fileType  String?
  sizeBytes Int?
  createdAt DateTime   @default(now())
}

// ===================== COMMERCIAL AREA =====================
// Covers both "Commercial area for sale" and "Commercial area for rent"

model CommercialArea {
  id    String @id @default(uuid())
  title String // e.g. "Office space for rent in CBD"

  listingType String // SALE | RENT
  salePrice   Decimal? @db.Decimal(14, 2)
  monthlyRent Decimal? @db.Decimal(14, 2)
  rentalTerm  String? // MONTHLY, 3_MONTHS, 4_MONTHS, 6_MONTHS, YEARLY

  sizeUnit String? // sqm, acre, plot, metre, feet
  size     Decimal? @db.Decimal(12, 2)

  propertyType       PropertyType?     @relation(fields: [propertyTypeId], references: [id])
  propertyTypeId     String? // Office Building, Warehouse, Petrol Station...
  propertyCategory   PropertyCategory? @relation(fields: [propertyCategoryId], references: [id])
  propertyCategoryId String?

  status String @default("PENDING") // ACTIVE, PENDING, SOLD, RENTED, ARCHIVED

  broker   Broker? @relation(fields: [brokerId], references: [id])
  brokerId String?
  owner    Owner?  @relation(fields: [ownerId], references: [id])
  ownerId  String?

  region        Region?   @relation(fields: [regionId], references: [id])
  regionId      String?
  district      District? @relation(fields: [districtId], references: [id])
  districtId    String?
  ward          Ward?     @relation(fields: [wardId], references: [id])
  wardId        String?
  exactLocation String?
  latitude      Float?
  longitude     Float?

  description String? @db.Text
  language    String  @default("ENGLISH")

  features  CommercialAreaFeature[]
  images    CommercialAreaImage[]
  documents CommercialAreaDocument[]
  videos    CommercialAreaVideo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, listingType])
}

model CommercialAreaFeature {
  id           String         @id @default(uuid())
  name         String
  commercial   CommercialArea @relation(fields: [commercialId], references: [id], onDelete: Cascade)
  commercialId String
}

model CommercialAreaImage {
  id           String         @id @default(uuid())
  commercial   CommercialArea @relation(fields: [commercialId], references: [id], onDelete: Cascade)
  commercialId String
  url          String       @db.LongText
  isCover      Boolean        @default(false)
  createdAt    DateTime       @default(now())
}

model CommercialAreaDocument {
  id           String         @id @default(uuid())
  commercial   CommercialArea @relation(fields: [commercialId], references: [id], onDelete: Cascade)
  commercialId String
  name         String
  url          String       @db.LongText
  fileType     String?
  sizeBytes    Int?
  createdAt    DateTime       @default(now())
}

model CommercialAreaVideo {
  id           String         @id @default(uuid())
  commercial   CommercialArea @relation(fields: [commercialId], references: [id], onDelete: Cascade)
  commercialId String
  url          String         @db.LongText
  fileType     String?
  sizeBytes    Int?
  createdAt    DateTime       @default(now())
}


